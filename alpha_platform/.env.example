# =================================================================
# ALPHA QUANT PLATFORM - EXAMPLE CONFIGURATION (.env.example)
# =================================================================
# Copy this file to .env and fill in your real values.
# NEVER commit your real .env file to git (it is in .gitignore).

# General Platform Settings
PROJECT_NAME="Alpha Quant Platform"
ENVIRONMENT="production"  # or "development"
DEBUG=False

# -----------------------------------------------------------------
# Telegram Bot Notifications
# -----------------------------------------------------------------
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# -----------------------------------------------------------------
# Exness MetaTrader 5 Account Settings
# -----------------------------------------------------------------
BROKER_NAME="Exness MT5"
MT5_ACCOUNT_LOGIN=12345678
MT5_ACCOUNT_PASSWORD=""
MT5_ACCOUNT_SERVER="Exness-Trial5"

# ZMQ Bridge Ports (Default: 5555, 5556)
MT5_ZMQ_PUB_PORT=5555
MT5_ZMQ_REP_PORT=5556

# -----------------------------------------------------------------
# Database Infrastructure
# -----------------------------------------------------------------
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="alpha_quant"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD=""

REDIS_HOST="localhost"
REDIS_PORT=6379

# -----------------------------------------------------------------
# Web Dashboard CORS Origins (comma-separated)
# -----------------------------------------------------------------
ALLOWED_ORIGINS="https://your-dashboard.onrender.com,http://localhost:5173"

# -----------------------------------------------------------------
# News Filter (optional API key for FMP provider)
# -----------------------------------------------------------------
NEWS_API_KEY=""
